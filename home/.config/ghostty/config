# font
# font-family="Fira Code"
font-size=17
font-style=Regular

# ligatures
# JetBrains Mono:
font-feature=-calt
font-feature=zero
font-feature=cv12,cv18,cv19,cv20
# Fira Code:
# font-feature=-calt
# font-feature=-liga
# font-feature=-dlig
# font-feature=ss05
# font-feature=ss03

# theme
theme=Dracula+

# cursor
shell-integration-features=no-cursor,no-sudo,ssh-env,ssh-terminfo
cursor-style=block
cursor-style-blink=false
# adjust-cursor-thickness=3

# window
window-height=40
window-width=120
window-padding-x = 10

macos-titlebar-style=tabs

window-save-state = always
mouse-hide-while-typing = true
shell-integration = zsh
quit-after-last-window-closed=true
window-inherit-working-directory = true
split-divider-color = #702b0d

# gws keybinds (tmux-style prefix: ctrl+b > key)
keybind = ctrl+b>shift+d=text:\x20todo\n
keybind = ctrl+b>f=text:\x20gws\n
keybind = ctrl+b>v=text:\x20gws split right\n
keybind = ctrl+b>s=text:\x20gws split down\n
keybind = ctrl+b>c=text:\x20gws tab\n
keybind = ctrl+b>x=text:\x20gws kill\n
keybind = ctrl+b>shift+x=text:\x20gws pick --kill\n

auto-update-channel = tip
